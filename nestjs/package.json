{
  "name": "@chat-poc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "dev:preflight": "node scripts/preflight.mjs",
    "db:up": "node scripts/database.mjs up",
    "db:seed": "node scripts/database.mjs seed",
    "dev:setup": "node scripts/setup.mjs",
    "start:dev": "tsx watch src/main.ts",
    "dev:local": "npm run build && node scripts/start-local.mjs",
    "db:migrate:room-sync": "npm run build && node scripts/migrate-room-sync.mjs"
  },
  "dependencies": {
    "@chat-poc/contracts": "file:../shared",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "dotenv": "17.2.3",
    "jose": "6.2.12",
    "mongoose": "9.11.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "jest": "30.5.2",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "ws": "8.18.3"
  }
}
